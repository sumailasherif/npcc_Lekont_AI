# Copy to .env and fill in locally. Never commit .env.

# --- API ---
API_ENV=development
API_HOST=127.0.0.1
API_PORT=8000
CORS_ORIGINS=http://localhost:3000

# --- OpenCode Go (only model provider used by this project) ---
# Get a key from https://opencode.ai/console (Go plan).
# Endpoint: https://opencode.ai/inference/go/openai/v1 (OpenAI-compatible)
OPENCODE_GO_API_KEY=
OPENCODE_GO_BASE_URL=https://opencode.ai/inference/go/openai/v1
LLM_MODEL=deepseek-v4.1-flash
# Zero-cost alternatives while available: beam-free, longcat-2.5-free, iceman-contributor-free

# --- Supabase (free tier: Postgres + pgvector) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=

# --- Web ---
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- WhatsApp Cloud API (optional; simulator works without it) ---
WHATSAPP_VERIFY_TOKEN=lekont-demo
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
