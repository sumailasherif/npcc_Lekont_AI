  "components": {
    "schemas": {
      "AnalyticsSummary": {
        "properties": {
          "questions_total": {
            "type": "integer",
            "title": "Questions Total"
          },
          "covered_rate": {
            "type": "number",
            "title": "Covered Rate"
          },
          "gaps_open": {
            "type": "integer",
            "title": "Gaps Open"
          },
          "sops_published": {
            "type": "integer",
            "title": "Sops Published"
          },
          "sops_in_review": {
            "type": "integer",
            "title": "Sops In Review"
          },
          "languages": {
            "items": {
              "$ref": "#/components/schemas/Language"
            },
            "type": "array",
            "title": "Languages"
          }
        },
        "type": "object",
        "required": [
          "questions_total",
          "covered_rate",
          "gaps_open",
          "sops_published",
          "sops_in_review",
          "languages"
        ],
        "title": "AnalyticsSummary"
      },
      "ApproveRequest": {
        "properties": {
          "reviewer": {
            "type": "string",
            "maxLength": 120,
            "minLength": 2,
            "title": "Reviewer"
          },
          "comment": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 1000
              },
              {
                "type": "null"
              }
            ],
            "title": "Comment"
          }
        },
        "type": "object",
        "required": [
          "reviewer"
        ],
        "title": "ApproveRequest"
      },
      "ChatTurn": {
        "properties": {
          "role": {
            "type": "string",
            "enum": [
              "user",
              "assistant"
            ],
            "title": "Role"
          },
          "content": {
            "type": "string",
            "title": "Content"
          }
        },
        "type": "object",
        "required": [
          "role",
          "content"
        ],
        "title": "ChatTurn"
      },
      "Citation": {
        "properties": {
          "sop_id": {
            "type": "string",
            "title": "Sop Id"
          },
          "version": {
            "type": "integer",
            "title": "Version"
          },
          "step": {
            "type": "integer",
            "title": "Step"
          },
          "quote": {
            "type": "string",
            "title": "Quote"
          }
        },
        "type": "object",
        "required": [
          "sop_id",
          "version",
          "step",
          "quote"
        ],
        "title": "Citation"
      },
      "Expert": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "initials": {
            "type": "string",
            "title": "Initials"
          },
          "role": {
            "type": "string",
            "title": "Role"
          },
          "organisation": {
            "type": "string",
            "title": "Organisation"
          },
          "country": {
            "type": "string",
            "title": "Country"
          },
          "city": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "City"
          },
          "categories": {
            "items": {
              "$ref": "#/components/schemas/ExpertCategory"
            },
            "type": "array",
            "title": "Categories"
          },
          "headline": {
            "type": "string",
            "title": "Headline"
          },
          "bio": {
            "type": "string",
            "title": "Bio"
          },
          "languages": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Languages"
          },
          "accent": {
            "type": "string",
            "title": "Accent"
          },
          "featured": {
            "type": "boolean",
            "title": "Featured",
            "default": false
          },
          "mauritian": {
            "type": "boolean",
            "title": "Mauritian",
            "default": false
          },
          "verified": {
            "type": "boolean",
            "title": "Verified",
            "default": false
          },
          "profile_type": {
            "type": "string",
            "enum": [
              "public_record",
              "composite"
            ],
            "title": "Profile Type",
            "default": "public_record"
          },
          "disclaimer": {
            "type": "string",
            "title": "Disclaimer"
